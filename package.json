    "@rtcoder/dominant-color": "^0.1.4",
    "@types/dompurify": "^3.0.5",
    "axios": "^1.13.2",
    "axios-retry": "^4.5.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "dashjs": "^5.1.0",
    "dompurify": "^3.3.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
