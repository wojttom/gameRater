{
  "name": "dyplom",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "dev": "ts-node-dev --respawn --transpile-only ./backend/server.ts",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
